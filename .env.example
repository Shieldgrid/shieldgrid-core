# Shieldgrid Core — Environment Variable Reference
#
# Copy this file to `.env` and fill in real values for local development.
# `.env` is gitignored; this file (.env.example) is committed.
#
# For Docker Compose, these vars can also be set in the `environment:` block
# in docker-compose.yml — see that file for the dev defaults.

# ── API server ────────────────────────────────────────────────────────────────
# TCP port the API will listen on.
PORT=3000

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection URL.  The docker-compose dev stack starts Postgres on
# the default port with the credentials below.
DATABASE_URL=postgres://shieldgrid:shieldgrid@localhost:5432/shieldgrid

# ── OpenSearch / Wazuh ────────────────────────────────────────────────────────
# Base URL of the OpenSearch cluster that indexes Wazuh alerts.
# No trailing slash.
OPENSEARCH_URL=http://localhost:9200

# Basic-auth credentials for OpenSearch (Wazuh ships with "admin"/"admin" by
# default on a fresh install — change these in production).
OPENSEARCH_USER=admin
OPENSEARCH_PASS=admin
